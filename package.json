{
    "name": "finsight",
    "version": "0.0.0",
    "private": true,
    "description": "Learn the world of finance through browser-based simulations and realistic simplified scenarios.",
    "type": "module",
    "scripts": {
        "dev": "vite",
        "build": "tsc --noEmit && vite build",
