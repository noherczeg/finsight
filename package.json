        "lint": "oxlint",
        "format": "oxfmt",
        "format:check": "oxfmt --check"
    },
    "dependencies": {
        "react": "19.2.8",
        "react-dom": "19.2.8"
    },
    "devDependencies": {
        "@tailwindcss/vite": "4.3.3",
        "@testing-library/jest-dom": "^6.6.3",
        "@testing-library/react": "^16.3.0",
        "@types/react": "^19.2.0",
        "@types/react-dom": "^19.2.0",
        "@vitejs/plugin-react": "6.1.0",
        "jsdom": "^26.1.0",
        "oxfmt": "0.65.0",
        "oxlint": "1.80.0",
        "tailwindcss": "4.3.3",
        "typescript": "7.0.2",
        "vite": "8.2.2",
        "vitest": "4.1.11"
    },
    "packageManager": "pnpm@11.22.0"
